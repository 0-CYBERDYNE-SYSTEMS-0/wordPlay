# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/wordplay

# AI API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here

# Optional: OpenAI-compatible endpoint override (local MLX Gemma E2B via mlx_lm.server)
OPENAI_BASE_URL=http://127.0.0.1:18110/v1

# Optional: local mflux bridge for FLUX.2 Klein image generation (default steps = 1)
MFLUX_BRIDGE_URL=http://127.0.0.1:4030
MFLUX_STEPS=1

# Optional: Ollama URL for local AI (if using Ollama)
OLLAMA_URL=http://localhost:11434

# Optional: override the Gemini image model used by /image
# Default is gemini-3.1-flash-lite-image (Nano Banana 2 Lite).
# IMPORTANT: must be an image-capable model; plain "gemini-3.1-flash-lite" is text-only.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Team sign-in (leave unset for single-user local mode)
# When set, the app requires the shared password at / and every user picks a
# display name; projects/documents become per-user.
# AUTH_PASSWORD=change-me
# Optional: explicit cookie-signing secret (derived automatically if unset)
# AUTH_SECRET=some-long-random-string

# Optional: custom image endpoint speaking the OpenAI /v1/images/generations
# shape — works with ComfyUI bridges, A1111 --api, SD WebUI, hosted gateways.
# Select "Custom endpoint" under Settings → AI → Image Generation to use it.
# IMAGE_API_URL=http://127.0.0.1:7860/v1
# IMAGE_API_KEY=
# IMAGE_API_MODEL=

# App Configuration
NODE_ENV=development
PORT=5001
# Bind address: set 0.0.0.0 to expose the server to your LAN/team
HOST=localhost
# Optional: AI request timeout (ms) for interactive slash-command calls
# AI_REQUEST_TIMEOUT_MS=120000
