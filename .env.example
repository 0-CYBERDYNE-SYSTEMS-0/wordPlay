# wordPlay environment configuration
# Copy to .env and fill in values you want to use.

# --- Database (required) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/wordplay
# Database SSL — OPT-IN. Only set this for managed cloud Postgres (Neon etc.);
# local/LAN Postgres (incl. the docker-compose db) does not support SSL and
# production mode no longer forces it.
# DATABASE_SSL=true

# --- Cloud AI (optional — leave empty to use only local Ollama) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
# Perplexity web research (optional; search stays honestly disabled without it)
PERPLEXITY_API_KEY=

# Kimi Coding Plan (Moonshot) — dedicated cloud provider. Select
# "Kimi (Coding Plan)" in Settings -> AI.
# KIMI_API_KEY=
# Optional override (default is the coding-plan endpoint):
# KIMI_BASE_URL=https://api.kimi.com/coding/v1

# Custom OpenAI-compatible provider (Settings -> AI -> "Custom"): any local or
# cloud OpenAI-shaped endpoint — MLX, LM Studio, vLLM, OpenRouter, Groq...
# CUSTOM_BASE_URL=http://127.0.0.1:18110/v1
# CUSTOM_API_KEY=
# Legacy: if CUSTOM_BASE_URL is unset, OPENAI_BASE_URL still works as the
# custom endpoint for backwards compatibility.
# OPENAI_BASE_URL=http://127.0.0.1:18110/v1

# --- Local AI (optional — recommended for offline use) ---
OLLAMA_URL=http://localhost:11434

# --- Image generation ---
# Local mflux bridge for FLUX.2 Klein (default steps = 1)
MFLUX_BRIDGE_URL=http://127.0.0.1:4030
MFLUX_STEPS=1
# Optional: override the Gemini image model used by /image
# Default is gemini-3.1-flash-lite-image (Nano Banana 2 Lite).
# IMPORTANT: must be an image-capable model; plain "gemini-3.1-flash-lite" is text-only.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Optional: custom image endpoint speaking the OpenAI /v1/images/generations
# shape — works with ComfyUI bridges, A1111 --api, SD WebUI, hosted gateways.
# Select "Custom endpoint" under Settings → AI → Image Generation to use it.
# IMAGE_API_URL=http://127.0.0.1:7860/v1
# IMAGE_API_KEY=
# IMAGE_API_MODEL=

# --- Team sign-in (leave unset for single-user local mode) ---
# When set, the app requires the shared password at / and every user picks a
# display name; projects/documents become per-user.
# AUTH_PASSWORD=change-me
# Optional: explicit cookie-signing secret (derived automatically if unset)
# AUTH_SECRET=some-long-random-string

# --- App ---
NODE_ENV=development
# The API server binds here; the Vite dev server (5173) proxies /api and
# /uploads to this port. Set HOST=0.0.0.0 to expose it to your LAN/team.
HOST=localhost
PORT=5001
# Optional: AI request timeout (ms) for interactive slash-command calls
# AI_REQUEST_TIMEOUT_MS=120000
