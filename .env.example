# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/wordplay

# AI API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here

# Optional: Ollama URL for local AI (if using Ollama)
OLLAMA_URL=http://localhost:11434

# Optional: override the Gemini image model used by /image
# Default is gemini-3.1-flash-lite-image (Nano Banana 2 Lite).
# IMPORTANT: must be an image-capable model; plain "gemini-3.1-flash-lite" is text-only.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# App Configuration
NODE_ENV=development
PORT=5001